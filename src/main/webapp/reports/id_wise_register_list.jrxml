	<queryString>
		<![CDATA[SELECT
     user_register.`user_id` AS user_register_user_id,
     user_register.`username` AS user_register_username,
     user_register.`contact` AS user_register_contact,
     user_register.`email` AS user_register_email,
     user_register.`address` AS user_register_address,
     user_register.`password` AS user_register_password
FROM
     `user_register` user_register

where
user_id = $P{id};]]>
