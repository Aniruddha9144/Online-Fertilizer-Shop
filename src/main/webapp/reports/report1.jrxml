	<queryString>
		<![CDATA[SELECT
     shipping_address.`product_id` AS shipping_address_product_id,
     shipping_address.`full_name` AS shipping_address_full_name,
     shipping_address.`mobile` AS shipping_address_mobile,
     shipping_address.`email` AS shipping_address_email,
     shipping_address.`address` AS shipping_address_address,
     shipping_address.`city` AS shipping_address_city,
     shipping_address.`state` AS shipping_address_state,
     shipping_address.`pincode` AS shipping_address_pincode,
     shipping_address.`country` AS shipping_address_country,
     shipping_address.`user_id` AS shipping_address_user_id
FROM
     `shipping_address` shipping_address
where
      product_id = $P{id};]]>
	</queryString>
