	<queryString>
		<![CDATA[SELECT
     user_payment.`payment_id` AS user_payment_payment_id,
     user_payment.`card_name` AS user_payment_card_name,
     user_payment.`card_number_upi_id` AS user_payment_card_number_upi_id,
     user_payment.`card_expiry` AS user_payment_card_expiry,
     user_payment.`card_cvv` AS user_payment_card_cvv,
     user_payment.`payment_method` AS user_payment_payment_method,
     user_payment.`pay_date` AS user_payment_pay_date,
     user_payment.`user_id` AS user_payment_user_id,
     user_payment.`amount` AS user_payment_amount
FROM
     `user_payment` user_payment

where
pay_date = $P{date};]]>
	</queryString>
