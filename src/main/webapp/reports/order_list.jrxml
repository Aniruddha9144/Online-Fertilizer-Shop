	<queryString language="SQL">
		<![CDATA[SELECT
     user_order.`order_id` AS user_order_order_id,
     user_order.`user_id` AS user_order_user_id,
     user_order.`product_name` AS user_order_product_name,
     user_order.`product_image` AS user_order_product_image,
     user_order.`price` AS user_order_price,
     user_order.`quantity` AS user_order_quantity,
     user_order.`total` AS user_order_total,
     user_order.`full_name` AS user_order_full_name,
     user_order.`mobile` AS user_order_mobile,
     user_order.`email` AS user_order_email,
     user_order.`address` AS user_order_address,
     user_order.`status` AS user_order_status,
     user_order.`pay_date` AS user_order_pay_date,
     user_order.`delevery_date` AS user_order_delevery_date
FROM
     `user_order` user_order]]>
	</queryString>
